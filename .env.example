# ---------- Backend (copy to backend/.env or repo-root .env) ----------
# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=acmecorp

# Admin login for the UI/API
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign session tokens (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-long-random-string

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Deterministic "today" (YYYY-MM-DD). Leave empty to use the real date.
APP_AS_OF_DATE=

# ---------- Email (organization mailbox) ----------
ORG_EMAIL_ADDRESS=your-org-inbox@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-org-inbox@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_STARTTLS=true
SMTP_SSL=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-org-inbox@gmail.com
IMAP_PASSWORD=your-16-char-app-password
IMAP_SSL=true
IMAP_FOLDER=INBOX
# Background inbox poll interval in seconds (0 disables the poller)
INBOX_POLL_SECONDS=60

# ---------- Collections policy ----------
# Minimum days between reminders to the same customer
REMINDER_INTERVAL_DAYS=7
# Scheduled reminder run interval in minutes (0 disables; manual button always works)
REMINDER_SCHEDULE_MINUTES=0

# ---------- LLM ----------
# gemini | groq | openai_compatible | none
LLM_PROVIDER=gemini
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-2.5-flash
# Only for openai_compatible
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# ---------- Seed overrides (optional) ----------
# Comma separated customer_id=email pairs applied by the seed script
# e.g. SEED_CUSTOMER_EMAILS=C002=my.test.customer@gmail.com,C007=other@gmail.com
SEED_CUSTOMER_EMAILS=
